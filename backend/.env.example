DJANGO_SECRET_KEY=replace-this-with-a-local-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SETTINGS_MODULE=recycleiq.settings.local

# Use sqlite locally; set DB_ENGINE=postgresql and fill in the DB_* values for PostgreSQL.
DB_ENGINE=sqlite
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432

# Comma-separated browser origins allowed to call the API directly during local development.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173